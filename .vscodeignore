# Package only what the extension needs at runtime:
# dist/ (extension.js, webview.js/css, validators.js), media/, package.json, package.nls.json,
# src/core/schema/board.schema.json (referenced by jsonValidation), README/LICENSE.
.kiro/**
.github/**
.vscode/**
.vscode-test/**
out-int/**
node_modules/**
scripts/**
test/**
src/**
!src/core/schema/board.schema.json
**/*.ts
**/*.tsx
**/*.map
**/*.log
*.log
tsconfig.json
vitest.config.mts
vitest.perf.config.mts
docs/**
*.vsix
*.txt
*.tmp
*.cmd
.vt.log
!LICENSE
!dist/mcp.js
!dist/mcp-tools.json
!dist/mcp-skill.json
!dist/quickjs.wasm
eslint.config.mjs
esbuild.config.mjs
package-lock.json
.gitignore
