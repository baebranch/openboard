      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mime": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp",
            "image/svg+xml"
          ]
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
