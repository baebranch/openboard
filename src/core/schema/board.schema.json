      },
      "required": [
        "id",
        "mime",
        "hash",
        "width",
        "height",
        "data"
      ],
      "additionalProperties": true
    },
    "LibraryComponent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
