{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openboard.dev/schemas/board.schema.json",
  "title": "OpenBoard Board_File",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "meta": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "modifiedAt": {
          "type": "string"
        },
        "generator": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": true
    },
    "viewport": {
      "$ref": "#/$defs/Viewport"
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Element"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Asset"
      }
    },
    "library": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LibraryComponent"
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "grid": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "spacing": {
              "type": "number",
              "minimum": 1
            }
          },
          "required": [
            "enabled",
            "spacing"
          ],
          "additionalProperties": true
        },
        "minimap": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "required": [
    "schemaVersion",
    "meta",
    "viewport",
    "elements",
    "assets",
    "library"
  ],
  "additionalProperties": true,
  "$defs": {
    "Element": {
      "type": "object",
      "discriminator": {
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Element_rectangle"
        },
        {
          "$ref": "#/$defs/Element_ellipse"
        },
        {
          "$ref": "#/$defs/Element_diamond"
        },
        {
          "$ref": "#/$defs/Element_line"
        },
        {
          "$ref": "#/$defs/Element_arrow"
        },
